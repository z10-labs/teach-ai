DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). Required for transcript extraction, embeddings and recall.
AI_GATEWAY_API_KEY=
# Optional model overrides (AI Gateway model ids)
EXTRACTION_MODEL=openai/gpt-5-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Local Inngest dev server. In production set INNGEST_SIGNING_KEY and INNGEST_EVENT_KEY instead.
INNGEST_DEV=1

# Optional: when set, /api routes (except /api/inngest) require `Authorization: Bearer <key>`
TEACH_AI_API_KEY=
